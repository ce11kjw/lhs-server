# ============================================================
# 灵画师 全新开服 · 部署配置模板
# 用法：cp deploy.env.example deploy.env → 填好 → ./deploy.sh
# ⚠️ deploy.env 含密码，已在 .gitignore 中排除，切勿提交
# ============================================================

# --- 代码来源（二选一）---
# A) 一般不用填（仓库已公开，脚本匿名 clone）
GITHUB_TOKEN=

# B) 或者用本机已有的 tgz 包目录（1-code/2-web/5-js.tgz）
PACK_DIR=

# --- 游戏素材 update/（约 3.8G，必须，否则进不去游戏）---
# 支持：本机目录 | .tgz/.tar.gz | https:// URL | user@host:/路径
UPDATE_SRC=
# 上面用 user@host: 形式时填源机密码
UPDATE_PASS=

# --- 必填：账号密码（脚本会在缺失时当场询问）---
ADMIN_PASS=
MYSQL_PASS=
GM_CODE=

# --- 可选 ---
HTTP_PORT_CFG=81
