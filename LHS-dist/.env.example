NODE_ENV=production
PORT=3001
MONGODB_URI=mongodb://127.0.0.1:27017/lhs_dist
DEFAULT_ADMIN_ENABLED=true
DEFAULT_ADMIN_USERNAME=aplm
DEFAULT_ADMIN_PASSWORD=<后台密码>
DEFAULT_ADMIN_SYNC_PASSWORD=true
DEFAULT_ADMIN_PHONE=13900000001
JWT_SECRET=<openssl rand -hex 64>
INTERNAL_API_KEY=<与游戏服 DIST_API_KEY 一致>
CORS_ALLOWED_ORIGINS=*
CORS_ALLOW_ALL=true
